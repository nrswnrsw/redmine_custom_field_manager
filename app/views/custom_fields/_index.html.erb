<% fields = (@custom_fields_by_type[tab[:name]] || []).sort %>
<% manager_id = "rcfm-custom-fields-#{tab[:name].underscore.dasherize}" %>

<%= form_tag(
      rcfm_custom_field_order_path,
      :method => :put,
      :id => manager_id,
      :class => 'rcfm-manager',
      :data => {
        :rcfm_manager => 'custom-fields',
        :rcfm_selection_error => l(:rcfm_selection_error),
        :rcfm_target_error => l(:rcfm_target_error),
        :rcfm_target_required => l(:rcfm_target_required),
        :rcfm_target_not_found => l(:rcfm_target_not_found),
        :rcfm_target_ambiguous => l(:rcfm_target_ambiguous),
        :rcfm_target_candidate => l(:rcfm_target_candidate, :position => '__POSITION__', :name => '__NAME__'),
        :rcfm_target_candidate_selected => l(:rcfm_target_candidate_selected),
        :rcfm_selected_count => l(:rcfm_selected_count, :count => '__COUNT__'),
        :rcfm_move_selected_count => l(:rcfm_move_selected_count, :count => '__COUNT__'),
        :rcfm_no_changes => l(:rcfm_no_changes),
        :rcfm_changed_count => l(:rcfm_changed_count, :count => '__COUNT__'),
        :rcfm_save_error => l(:rcfm_save_error),
        :rcfm_server_state => l(:rcfm_server_state_summary, :count => '__COUNT__'),
        :rcfm_confirm_discard => l(:rcfm_confirm_discard),
        :rcfm_confirm_force => l(:rcfm_confirm_force),
        :rcfm_conflict_base => l(:rcfm_conflict_base),
        :rcfm_conflict_mine => l(:rcfm_conflict_mine),
        :rcfm_conflict_server => l(:rcfm_conflict_server),
        :rcfm_conflict_merge => l(:rcfm_conflict_merge),
        :rcfm_state_position => l(:rcfm_state_position, :position => '__POSITION__')
      }
    ) %>
  <%= hidden_field_tag :field_type, tab[:name] %>
  <%= hidden_field_tag :base_digest, RedmineCustomFieldManager::Snapshot.custom_fields_digest(:field_type => tab[:name]) %>
  <%= hidden_field_tag :base_snapshot,
                       RedmineCustomFieldManager::Snapshot.custom_fields(:field_type => tab[:name], :records => fields).to_json,
                       :class => 'rcfm-base-snapshot' %>
  <%= hidden_field_tag :ordered_ids, fields.map(&:id).to_json, :class => 'rcfm-ordered-ids' %>
  <%= hidden_field_tag :force, '0', :class => 'rcfm-force' %>
  <%= hidden_field_tag :confirmed_digest, '', :class => 'rcfm-confirmed-digest' %>
  <%= hidden_field_tag :resolution, 'normal', :class => 'rcfm-resolution' %>

  <div class="rcfm-toolbar box">
    <div class="rcfm-selection-bar">
      <div class="rcfm-selection-summary">
        <span class="rcfm-group-label"><%= l(:rcfm_move_selection_group) %></span>
        <span class="rcfm-selection-count" aria-live="polite"><%= l(:rcfm_selected_count, :count => 0) %></span>
      </div>
      <div class="rcfm-selection-controls">
        <%= button_tag sprite_icon('checked', l(:rcfm_select_all)),
                       :type => 'button',
                       :class => 'rcfm-select-all rcfm-button-quiet' %>
        <%= button_tag sprite_icon('cancel', l(:rcfm_clear_selection)),
                       :type => 'button',
                       :class => 'rcfm-clear-selection rcfm-button-quiet' %>
      </div>
    </div>

    <div class="rcfm-operation-grid rcfm-operation-grid--single">
      <details class="rcfm-operation-panel rcfm-operation-panel--move rcfm-bulk-move">
        <summary>
          <span><%= l(:rcfm_move_selected_group) %></span>
          <span class="rcfm-bulk-move-count"><%= l(:rcfm_selected_count, :count => 0) %></span>
        </summary>
        <div class="rcfm-operation-panel-body">
          <p class="rcfm-bulk-move-help"><%= l(:rcfm_bulk_move_help) %></p>
          <div class="rcfm-move-controls">
            <label class="rcfm-target-field">
              <span><%= l(:rcfm_move_target) %></span>
              <input type="text"
                     class="rcfm-target"
                     list="<%= manager_id %>-targets"
                     autocomplete="off"
                     placeholder="<%= l(:rcfm_move_target_placeholder) %>">
            </label>
            <datalist id="<%= manager_id %>-targets" class="rcfm-target-list">
              <% fields.each_with_index do |field, index| %>
                <option value="<%= h "#{l(:rcfm_target_candidate, :position => index + 1, :name => field.name)} (##{field.id})" %>"></option>
              <% end %>
            </datalist>
            <div class="rcfm-move-side" role="group" aria-label="<%= l(:rcfm_move_position) %>">
              <label><input type="radio" name="rcfm_move_side_<%= manager_id %>" value="before" checked> <%= l(:rcfm_before) %></label>
              <label><input type="radio" name="rcfm_move_side_<%= manager_id %>" value="after"> <%= l(:rcfm_after) %></label>
            </div>
            <%= button_tag safe_join([
                  sprite_icon('move', ''),
                  tag.span(l(:rcfm_move_selected_count, :count => 0), :class => 'rcfm-move-selected-label')
                ]),
                           :type => 'button',
                           :class => 'rcfm-move-selected rcfm-button-action' %>
            <div class="rcfm-target-candidates" hidden aria-live="polite">
              <p class="rcfm-target-candidates-message"></p>
              <div class="rcfm-target-candidate-list"></div>
            </div>
          </div>
        </div>
      </details>
    </div>

    <div class="rcfm-error error" hidden></div>
  </div>

  <div class="rcfm-conflict box error" hidden>
    <h3><%= l(:rcfm_conflict_title) %></h3>
    <p class="rcfm-conflict-message"></p>
    <p class="rcfm-conflict-server-state"></p>
    <div class="rcfm-conflict-diffs"></div>
    <div class="rcfm-toolbar-row">
      <%= button_tag l(:rcfm_continue_editing), :type => 'button', :class => 'rcfm-conflict-continue' %>
      <%= button_tag l(:rcfm_discard_and_reload), :type => 'button', :class => 'rcfm-conflict-reload' %>
      <%= button_tag l(:rcfm_merge_and_save), :type => 'button', :class => 'rcfm-conflict-merge', :hidden => true %>
      <%= button_tag l(:rcfm_force_overwrite), :type => 'button', :class => 'rcfm-conflict-force' %>
    </div>
  </div>

  <table class="list custom_fields rcfm-sortable">
    <thead>
      <tr>
        <th class="rcfm-selection"><span class="hidden-for-sighted"><%= l(:rcfm_move_selection_group) %></span></th>
        <th><%= l(:field_name) %></th>
        <th><%= l(:field_field_format) %></th>
        <th><%= l(:field_is_required) %></th>
        <% if tab[:name] == 'IssueCustomField' %>
          <th><%= l(:field_is_for_all) %></th>
          <th><%= l(:label_used_by) %></th>
        <% end %>
        <th><span class="hidden-for-sighted"><%= l(:rcfm_individual_actions) %></span></th>
      </tr>
    </thead>
    <tbody>
      <% fields.each do |custom_field| %>
        <% back_url = custom_fields_path(:tab => tab[:name]) %>
        <tr data-rcfm-id="<%= custom_field.id %>" data-rcfm-name="<%= h custom_field.name %>">
          <td class="rcfm-selection">
            <input type="checkbox" class="rcfm-select" aria-label="<%= h l(:rcfm_select_field_for_move, :name => custom_field.name) %>">
          </td>
          <td class="name">
            <%= link_to custom_field.name, edit_custom_field_path(custom_field) %>
            <span class="rcfm-record-id">#<%= custom_field.id %></span>
          </td>
          <td><%= l(custom_field.format.label) %></td>
          <td><%= checked_image custom_field.is_required? %></td>
          <% if tab[:name] == 'IssueCustomField' %>
            <td><%= checked_image custom_field.is_for_all? %></td>
            <td><%= l(:label_x_projects, :count => @custom_fields_projects_count[custom_field.id] || 0) if custom_field.is_a?(IssueCustomField) && !custom_field.is_for_all? %></td>
          <% end %>
          <td class="buttons">
            <%= tag.span sprite_icon('reorder', ''), :class => 'icon-only icon-sort-handle sort-handle rcfm-sort-handle', :title => l(:button_move) %>
            <%= link_to_function sprite_icon('copy', l(:button_copy)), "location.href = '#{new_custom_field_path(:copy => custom_field)}&type=' + encodeURIComponent(($('.tabs a.selected').attr('id')||'').split('tab-').pop())", :class => 'icon icon-copy' %>
            <%= delete_link custom_field_path(custom_field),
                            {
                              :class => 'icon icon-del rcfm-delete-custom-field',
                              :data => {
                                :confirm => l(
                                  :rcfm_confirm_custom_field_delete,
                                  :name => custom_field.name,
                                  :id => custom_field.id
                                )
                              }
                            },
                            l(:rcfm_delete_custom_field) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="rcfm-commit-bar">
    <div class="rcfm-change-summary">
      <span class="rcfm-change-indicator" aria-hidden="true"></span>
      <div class="rcfm-status" aria-live="polite"><%= l(:rcfm_no_changes) %></div>
    </div>
    <div class="rcfm-commit-controls">
      <div class="rcfm-history-actions" aria-label="<%= l(:rcfm_edit_history_controls) %>">
        <%= button_tag l(:rcfm_undo),
                       :type => 'button',
                       :class => 'rcfm-undo rcfm-button-quiet',
                       :title => l(:rcfm_undo_help),
                       :disabled => true %>
        <%= button_tag l(:rcfm_redo),
                       :type => 'button',
                       :class => 'rcfm-redo rcfm-button-quiet',
                       :title => l(:rcfm_redo_help),
                       :disabled => true %>
      </div>
      <div class="rcfm-final-actions">
        <%= button_tag sprite_icon('cancel', l(:rcfm_discard_changes)),
                       :type => 'button',
                       :class => 'rcfm-reset rcfm-button-quiet',
                       :title => l(:rcfm_discard_changes_help),
                       :disabled => true %>
        <%= button_tag sprite_icon('save', l(:rcfm_save_changes)),
                       :type => 'submit',
                       :class => 'rcfm-save rcfm-button-primary',
                       :disabled => true %>
      </div>
    </div>
  </div>
</form>
